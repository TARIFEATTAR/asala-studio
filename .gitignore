# Build artifacts
/dist
/out

# Editor temp
.cursor/
# Ignore .claude/ contents (settings, worktrees, etc.) but keep shared project
# skills under version control. Use .claude/* (not .claude/) so git can descend
# into the directory — a negation can't re-include a path under an excluded dir.
.claude/*
!.claude/skills/

# macOS
.DS_Store
**/.DS_Store

# Logs
*.log

# Playwright MCP traces (local debug output)
.playwright-mcp/

# Local research/generation artifacts
.hermes/
.firecrawl/
/remotion/
/tmp/
/outputs/
/my-agent/
public/data/bb-generated-images-export.json
scripts/local-generate.ts
tsconfig.scripts.tmp.json

# env files
.env*

# Supabase generated
supabase/.next/
supabase/.temp/
.supabase/
node_modules
pnpm-lock.yaml
.vercel
